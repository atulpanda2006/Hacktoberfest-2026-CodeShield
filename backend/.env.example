# Server Configuration
NODE_ENV=development
PORT=3000

# Database Configuration
DATABASE_URL=postgresql://postgres:password@localhost:5432/trust_network_dev?schema=public

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=24h

# GitHub Configuration
GITHUB_API_BASE_URL=https://api.github.com

# OPTIONAL platform token, used only for anonymous public reads.
# User-specific actions always use each user's own token (Profile -> GitHub connection).
GITHUB_TOKEN=

# AES-256-GCM key that encrypts per-user GitHub tokens at rest.
# Generate with: openssl rand -hex 32
GITHUB_TOKEN_ENCRYPTION_KEY=change-me-with-openssl-rand-hex-32

# Optional GitHub OAuth App. Leave blank to support personal access tokens only.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3000/api/v1/github/oauth/callback
FRONTEND_URL=http://localhost:5173

# AI Service Configuration
AI_SERVICE_URL=http://localhost:5000/api
AI_SERVICE_TIMEOUT=30000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS
CORS_ORIGIN=http://localhost:5173

# Logging
LOG_LEVEL=info

# GitHub Integration (optional tuning)
# Fine-grained, read-only token is enough; without it GitHub allows 60 requests/hour.
GITHUB_TIMEOUT_MS=10000

# AI Service Integration (optional tuning)
AI_MAX_RETRIES=2
AI_RETRY_BASE_DELAY_MS=500
AI_MAX_COMMITS=100
